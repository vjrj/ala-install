  # CAS Authentication Server
services:
  cas:
    container_name: la_cas
    extra_hosts: {{ docker_extra_hosts | default([]) | to_json }}
{% if build_images | default(false) %}
    # Using locally built image
    image: cas:{{ cas_version | default('6.5.6-3') }}
    pull_policy: never
    build:
      context: ../../docker/cas5
      dockerfile: Dockerfile
      args:
        CAS_VERSION: {{ cas_version | default('6.5.6-3') }}
        CAS_REPO: {{ cas_repo | default('https://github.com/AtlasOfLivingAustralia/ala-cas-5.git') }}
        CAS_BRANCH: {{ cas_branch | default('master') }}
{% else %}
    # Using locally built image (from docker buildx bake)
    image: cas:{{ cas_version | default('6.5.6-3') }}
    pull_policy: never
{% endif %}
    volumes:
      - ../cas:/data/cas
      # - ../var-log-atlas/cas:/var/log/atlas/cas
{% include '_i18n_volumes.yml.j2' %}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      JAVA_OPTS: ${CAS_JAVA_OPTS}
    expose:
      - {{ cas_port | default('9000') }}
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
    depends_on:
{% if i18n.enabled and i18n.strategy == 'volume' and i18n.volume.source == 'init-container' %}
      i18n-init:
        condition: service_completed_successfully
{% endif %}
      mysql:
        condition: service_healthy
      mongodb:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "sh", "-c", "curl --fail --silent http://localhost:{{ cas_port | default('9000') }}/cas/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    restart: unless-stopped


