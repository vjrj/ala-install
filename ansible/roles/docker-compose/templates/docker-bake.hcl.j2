# ============================================
# Build Groups
# ============================================

# Build builders first
group "builders" {
  targets = [
    "gradle-builder-jdk8",
    "gradle-builder-jdk11",
    "gradle-builder-jdk17",
    "gradle-builder-jdk21",
    "maven-builder-jdk8",
    "maven-builder-jdk11",
    "maven-builder-jdk17",
    "maven-builder-jdk21",
  ]
}

# Build all services (depends on builders)
group "all" {
  targets = [
{% if i18n.enabled %}
    "ala-i18n",
{% endif %}
{% if 'branding' in group_names %}
    "branding",
{% endif %}
{% if 'collectory' in services_enabled %}
    "collectory",
{% endif %}
{% if 'species_lists' in services_enabled or groups['species-list'] is defined %}
    "species-list",
{% endif %}
{% if 'cas' in services_enabled %}
    "cas",
{% endif %}
{% if 'userdetails' in services_enabled %}
    "userdetails",
{% endif %}
{% if 'apikey' in services_enabled %}
    "apikey",
{% endif %}
{% if 'cas_management' in services_enabled %}
    "cas-management",
{% endif %}
{% if 'ala_bie' in services_enabled or bie_hub_enabled | default(false) %}
    "bie-hub",
{% endif %}
{% if 'bie_index' in services_enabled or bie_index_enabled | default(false) %}
    "bie-index",
{% endif %}
{% if 'ala_hub' in services_enabled or biocache_hub_enabled | default(false) %}
    "biocache-hub",
{% endif %}
{% if 'biocache_service' in services_enabled or biocache_service_enabled | default(false) %}
    "biocache-service",
{% endif %}
{% if 'namematching-service' in services_enabled or 'namematchingService' in services_enabled %}
    "namematching-service",
{% endif %}
{% if 'sensitive-data-service' in services_enabled or 'sensitiveDataService' in services_enabled %}
    "sensitive-data-service",
{% endif %}
# Gatus is launched directly from docker-compose without custom Dockerfile
{% if 'gatus' in services_enabled %}
{% endif %}
  ]
}

# Build only services (assumes builders exist)
group "services" {
  targets = [
{% if 'branding' in group_names %}
    "branding",
{% endif %}
{% if 'collectory' in services_enabled %}
    "collectory",
{% endif %}
{% if 'species_lists' in services_enabled or groups['species-list'] is defined %}
    "species-list",
{% endif %}
{% if 'cas' in services_enabled %}
    "cas",
{% endif %}
{% if 'userdetails' in services_enabled %}
    "userdetails",
{% endif %}
{% if 'apikey' in services_enabled %}
    "apikey",
{% endif %}
{% if 'cas' in services_enabled %}
    "cas-management",
{% endif %}
{% if 'ala_bie' in services_enabled or bie_hub_enabled | default(false) %}
    "bie-hub",
{% endif %}
{% if 'bie_index' in services_enabled or bie_index_enabled | default(false) %}
    "bie-index",
{% endif %}
{% if 'ala_hub' in services_enabled or biocache_hub_enabled | default(false) %}
    "biocache-hub",
{% endif %}
{% if 'biocache_service' in services_enabled or biocache_service_enabled | default(false) %}
