# Docker Bake configuration for Living Atlas services
# Generated by ala-install ansible templates
# Based on INBO pattern but adapted for generic LA portals

variable "TAG" {
  default = "{{ docker_tag | default('develop') }}"
}

variable "CACHE_TAG" {
  default = "{{ docker_cache_tag | default('buildcache') }}"
}

variable "DOCKER_REPO" {
  default = "{{ docker_registry | default('') }}"
}

# ============================================
# Builder Base Images (INBO pattern)
# ============================================

# Builders group for easy pre-building
group "builders" {
  targets = [
{% set active_builders = [] %}
{% for service_id in services_to_build %}
{% if service_id in docker_services_desc and docker_services_desc[service_id].get('buildTool') in ['gradle', 'maven'] %}
{% set tool = docker_services_desc[service_id].buildTool %}
{% set jdk = service_java_dict[service_id] | default('11') %}
{% if tool + "-builder-jdk" + jdk not in active_builders %}
    "{{ tool }}-builder-jdk{{ jdk }}",
{% set _ = active_builders.append(tool + "-builder-jdk" + jdk) %}
{% endif %}
{% endif %}
{% endfor %}
  ]
}

{% for tool in ['gradle', 'maven'] %}
{% for jdk in ['8', '11', '17', '21'] %}
# {{ tool | capitalize }} builder for JDK {{ jdk }} services
target "{{ tool }}-builder-jdk{{ jdk }}" {
  dockerfile = "Dockerfile"
  context = "dockerfiles/{{ tool }}"
  args = {
    JDK_VERSION = "{{ jdk }}"
    {% if tool == 'gradle' %}
    GRADLE_VERSION = "{{ '8' if jdk == '21' else '7' }}"
    {% else %}
    MAVEN_VERSION = "3.9"
    {% endif %}
  }
{% if docker_registry and docker_registry != '' %}
  tags = ["{{ docker_registry }}/{{ tool }}-builder:jdk{{ jdk }}"]
{% else %}
  tags = ["{{ tool }}-builder:jdk{{ jdk }}"]
{% endif %}
  output = ["type=docker"]
{% if docker_registry and docker_registry != '' %}
  cache-from = ["type=registry,ref={{ docker_registry }}/{{ tool }}-builder:jdk{{ jdk }}-${CACHE_TAG}"]
{% endif %}
  cache-to = ["type=inline"]
  platforms = ["linux/amd64"]
}
{% endfor %}
{% endfor %}

# ============================================
# Special Targets (i18n, branding)
# ============================================

{% if 'ala-i18n' in services_to_build %}
target "ala-i18n" {
  dockerfile = "Dockerfile"
  context = "dockerfiles/i18n"
  args = {}
{% if docker_registry and docker_registry != '' %}
  tags = ["{{ docker_registry }}/ala-i18n:{{ i18n_version }}", "{{ docker_registry }}/ala-i18n:latest"]
{% else %}
  tags = ["ala-i18n:{{ i18n_version }}", "ala-i18n:latest"]
{% endif %}
  cache-to = ["type=inline"]
  platforms = ["linux/amd64"]
}
{% endif %}

{% if 'branding' in services_to_build %}
target "branding" {
  dockerfile = "Dockerfile"
  context = "dockerfiles/branding"
  target = "builder-production"
  args = {
    BUILD_SOURCE = "{{ branding_build_source | default('local') }}"
{% if (branding_build_source | default('local')) == 'git' %}
    GIT_URL = "{{ branding_source }}"
    GIT_REF = "{{ branding_git_ref | default('master') }}"
{% endif %}
    NODE_VERSION = "{{ branding_node_version | default('18') }}"
  }
  tags = ["branding-builder:{{ branding_version | default('latest') }}", "branding-builder:latest"]
  cache-to = ["type=inline"]
  platforms = ["linux/amd64"]
}
{% endif %}

# ============================================
# Standard Services (Automated)
# ============================================

{% for service_id in services_to_build %}
{% if service_id in docker_services_desc and docker_services_desc[service_id].get('buildTool') in ['gradle', 'maven'] %}
{% set service = docker_services_desc[service_id] %}
{% set svc_role = service.role | default(service_id) %}
{% set svc_artifact = service.artifacts | default(svc_role) %}
{% set svc_java = service_java_dict[service_id] | default('11') %}
{% set svc_version = service_versions_dict[service_id] | default('develop') %}

target "{{ svc_role }}" {
  dockerfile = "Dockerfile"
  context = "dockerfiles/{{ svc_role }}"
  contexts = {
    # Use image from store, decoupled from the target build to avoid parallel rebuild issues on remote hosts
    "{{ service.buildTool }}-builder:jdk{{ svc_java }}" = "target:{{ service.buildTool }}-builder-jdk{{ svc_java }}"
  }
  args = {
    BUILDER_IMAGE = "{{ service.buildTool }}-builder:jdk{{ svc_java }}"
    {{ service.buildTool | upper }}_BUILDER_IMAGE = "{{ service.buildTool }}-builder:jdk{{ svc_java }}"
    BUILD_METHOD = "{{ service.buildMethod | default('nexus') }}"
    ARTIFACT = "{{ svc_artifact }}"
    GROUP_ID = "{{ service.groupId | default('au.org.ala') }}"
    VERSION = "{{ svc_version }}"
    REPO = "{{ service.repository | default('') }}"
    BRANCH = "{{ vars[service_id + '_branch'] | default('master') }}"
    {% if service.classifier is defined %}
    CLASSIFIER = "{{ service.classifier }}"
    {% endif %}
    {% if service.buildDir is defined %}
    BUILD_DIR = "{{ service.buildDir }}"
    {% endif %}
    {% if service.buildTool == 'maven' %}
    RUNTIME_IMAGE = "eclipse-temurin:{{ svc_java }}-jre-jammy"
    {% endif %}
    {% if service.extension is defined %}
    EXTENSION = "{{ service.extension }}"
    {% endif %}
  }
{% if docker_registry and docker_registry != '' %}
  tags = ["{{ docker_registry }}/{{ svc_artifact }}:{{ svc_version }}", "{{ docker_registry }}/{{ svc_artifact }}:latest"]
  cache-from = [
    "type=registry,ref={{ docker_registry }}/{{ svc_artifact }}:${CACHE_TAG}",
    "type=registry,ref={{ docker_registry }}/{{ svc_artifact }}:latest"
  ]
{% else %}
  tags = ["{{ svc_artifact }}:{{ svc_version }}", "{{ svc_artifact }}:latest"]
{% endif %}
  cache-to = ["type=inline"]
  platforms = ["linux/amd64"]
}
{% endif %}
{% endfor %}

# ============================================
# Build Groups
# ============================================

# Build all services (depends on builders)
group "all" {
  targets = [
{% if 'ala-i18n' in services_to_build %}
    "ala-i18n",
{% endif %}
{% for service_id in services_to_build %}
{% if service_id in docker_services_desc and docker_services_desc[service_id].get('buildTool') in ['gradle', 'maven'] %}
    "{{ docker_services_desc[service_id].role }}",
{% endif %}
{% endfor %}
  ]
}

# Build only services (assumes builders exist)
group "services" {
  targets = [
{% for service_id in services_to_build %}
{% if service_id in docker_services_desc and docker_services_desc[service_id].get('buildTool') in ['gradle', 'maven'] %}
    "{{ docker_services_desc[service_id].role }}",
{% endif %}
{% endfor %}
  ]
}
