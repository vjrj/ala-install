---
{#
  Autogenerated Gatus checks, one per nginx_paths entry of this vhost.

  gatus_up_conditions is the list every endpoint is checked against. It always carries
  [CONNECTED] == true, because a status-only condition such as "[STATUS] < 500" is
  *satisfied* when Gatus never reached the host at all: a failed request leaves the status
  at 0, and a host with broken DNS or a certificate that does not cover it then sits green.
  gatus_up_condition (the older single-condition variable) is still honoured.

  The vhost ROOT gets its own, stricter condition. A relaxed '[STATUS] < 500' is right for
  the rest, since plenty of API paths answer 400/404 without parameters while perfectly
  healthy. But a 404 on the ROOT cannot mean that: it means nothing is serving this
  server_name, i.e. the request landed on the wrong machine, and under '< 500' every check
  in the group then reports green. Set gatus_root_up_condition to relax it.

  gatus_up_conditions (plural) replaces the whole pair, so it wins for the root too: an
  explicit full override must not be quietly overruled by the root default.
#}
{% set up_conditions = gatus_up_conditions | default(['[CONNECTED] == true', gatus_up_condition | default('[STATUS] == 200')]) %}
{% set root_conditions = gatus_root_up_conditions | default(gatus_up_conditions | default(['[CONNECTED] == true', gatus_root_up_condition | default('[STATUS] < 400')])) %}
endpoints:
{% if ssl == true %}
{% set protocol = 'https' %}
{% else %}
{% set protocol = 'http' %}
{% endif %}
{% if nginx_paths | length == 0 %}
  - name: {{protocol}}://{{ hostname }}
    group: {{ hostname | default('internal') }}
    url: "{{protocol}}://{{ hostname }}"
    interval: {{ gatus_interval | default('5m') }}
    conditions:
{% for condition in root_conditions %}
      - "{{ condition }}"
{% endfor %}

{% endif %}
{% for entry in nginx_paths %}
{% if entry.path not in (nginx_paths_gatus_exclude | default([])) %}
{% set suffix_name = entry.path | replace("/", "-") %}
{% if suffix_name == "-" %}
{% set suffix_name = "root" %}
{% else %}
{% set suffix_name = suffix_name | trim('-') %}
{% endif %}
{# Most roles write their nginx_paths with a leading slash, sensitive-data-service does not,
   and this template used to concatenate them raw, yielding URLs with the host and the path
   run together. Normalise here so no role can get it wrong; "/" still renders as "/". #}
  - name: {{protocol}}://{{ hostname }}/{{ suffix_name }}
    group: {{ hostname | default('internal') }}
    url: "{{protocol}}://{{ hostname }}{{ '/' ~ (entry.path | regex_replace('^/+', '')) }}"
    interval: {{ gatus_interval | default('5m') }}
    conditions:
{% for condition in (root_conditions if suffix_name == 'root' else up_conditions) %}
      - "{{ condition }}"
{% endfor %}
{% endif %}
{% endfor %}
