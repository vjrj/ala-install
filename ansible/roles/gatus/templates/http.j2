---
endpoints:
{% if ssl == true %}
{% set protocol = 'https' %}
{% else %}
{% set protocol = 'http' %}
{% endif %}
{% if nginx_paths | length == 0 %}
  - name: {{protocol}}://{{ hostname }}
    group: {{ hostname | default('internal') }}
    url: "{{protocol}}://{{ hostname }}"
    interval: {{ gatus_interval | default('5m') }}
    conditions:
      # "Up" = the service answers through nginx without a server error. ALA
      # endpoints behind CAS legitimately return 302/401/403 (and param-less API
      # paths 400/404) while perfectly healthy, so a strict ==200 + non-empty body
      # produced massive false-reds. [STATUS] < 500 keeps only real outages red
      # (502/503/504/timeout/no upstream).
      - "[STATUS] < 500"

{% endif %}
{% for entry in nginx_paths %}
{% if entry.path not in (nginx_paths_gatus_exclude | default([])) %}
{% set suffix_name = entry.path | replace("/", "-") %}
{% if suffix_name == "-" %}
{% set suffix_name = "root" %}
{% else %}
{% set suffix_name = suffix_name | trim('-') %}
{% endif %}
  - name: {{protocol}}://{{ hostname }}/{{ suffix_name }}
    group: {{ hostname | default('internal') }}
    url: "{{protocol}}://{{ hostname }}{{ entry.path }}"
    interval: {{ gatus_interval | default('5m') }}
    conditions:
      # "Up" = the service answers through nginx without a server error. ALA
      # endpoints behind CAS legitimately return 302/401/403 (and param-less API
      # paths 400/404) while perfectly healthy, so a strict ==200 + non-empty body
      # produced massive false-reds. [STATUS] < 500 keeps only real outages red
      # (502/503/504/timeout/no upstream).
      - "[STATUS] < 500"
{% endif %}
{% endfor %}
