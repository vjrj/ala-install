  # Gatus Health Monitoring Dashboard
services:
  gatus:
    container_name: la_gatus_service
    image: twinproduction/gatus:latest
    volumes:
      - ../gatus/config:/etc/gatus/genconfig:ro
      - la_gatus-data:/data
    environment:
      TZ: {{ server_tz | default('UTC') }}
      GATUS_CONFIG_PATH: /config
    ports:
      - "8090:8080"
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
        aliases:
          - {{ gatus_hostname | default('gatus') }}
          - la_gatus_service
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 10s
    restart: unless-stopped


