  # API Key Service
services:
  apikey:
    container_name: la_apikey
{% if build_images | default(false) %}
    # Using locally built image
    image: apikey:{{ apikey_version | default('1.7.0') }}
    pull_policy: never
    build:
      context: ../../docker/apikey
      dockerfile: Dockerfile
      args:
        APIKEY_VERSION: {{ apikey_version | default('1.7.0') }}
        APIKEY_REPO: {{ apikey_repo | default('https://github.com/AtlasOfLivingAustralia/apikey.git') }}
        APIKEY_BRANCH: {{ apikey_branch | default('master') }}
{% else %}
    # Using locally built image (from docker buildx bake)
    image: apikey:{{ apikey_version | default('1.7.0') }}
    pull_policy: never
{% endif %}
    volumes:
      - ../apikey:/data/apikey
      # - ../var-log-atlas/apikey:/var/log/atlas/apikey
{% if i18n.enabled and i18n.strategy == 'volume' %}
      - {{ i18n.volume.name }}:/opt/atlas/i18n/:ro
{% endif %}
    environment:
      TZ: {{ server_tz | default('UTC') }}
      JAVA_OPTS: ${APIKEY_JAVA_OPTS}
    ports:
      - 9002
    networks:
      default: {}
      {{ docker_network | default('internal') }}:
    depends_on:
{% if i18n.enabled and i18n.strategy == 'volume' and i18n.volume.source == 'init-container' %}
      i18n-init:
        condition: service_completed_successfully
{% endif %}
      mysql:
        condition: service_healthy
      cas:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "sh", "-c", "curl --fail --silent http://localhost:8080/apikey/actuator/health || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 60s
    restart: unless-stopped


